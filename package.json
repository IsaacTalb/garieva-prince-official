{
  "name": "garieva-prince-official",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "generate-secrets": "node -e \"const crypto=require('crypto');console.log('AUTH_SESSION_SECRET='+crypto.randomBytes(32).toString('hex'))\" && node -e \"const crypto=require('crypto');console.log('AUTH_OTP_PEPPER='+crypto.randomBytes(16).toString('hex'))\"\">> .env.local 2>&1 || true",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "lucide-react": "0.468.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sql.js": "1.16.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.20.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  }
}
