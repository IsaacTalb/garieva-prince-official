# =============================================================================
# GARIEVA PRINCE — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# ⚠️  NEVER COMMIT THIS FILE TO GIT!
#    Copy this to .env.production and fill with actual production values.
# 
# Deploy platforms: Cloudflare Workers, Vercel, Railway, Render
# =============================================================================

# =============================================================================
# APP CONFIGURATION
# =============================================================================
APP_BASE_URL=https://yourdomain.com  # Replace with your actual domain

# =============================================================================
# DATABASE SETUP
# =============================================================================
# Option 1: Cloudflare D1 (recommended for Cloudflare deployment)
DATABASE_URL=cloudflare:D1:YOUR_DATABASE_ID  # Get from Cloudflare Dashboard → D1 → Database ID

# OR Option 2: PostgreSQL (for Railway, Render, self-hosted)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

CLOUDFLARE_D1_DATABASE_NAME=garieva-prince-prod

# =============================================================================
# AUTHENTICATION SESSION SECRETS
# =============================================================================
# ⚠️  REPLACE WITH STRONG RANDOM VALUES! Use at least 32 characters.
# Generate with: openssl rand -hex 32 (for session secret)
# OR generate with: npm run generate-secrets
AUTH_SESSION_SECRET=CHANGE_THIS_TO_RANDOM_32_CHAR_MINIMUM_GENERATE_WITH_OSSL
AUTH_OTP_PEPPER=CHANGE_THIS_TO_RANDOM_16_CHAR_MINIMUM_GENERATE_WITH_OSS

# =============================================================================
# BREVO EMAIL SERVICE (REQUIRED for OTP authentication)
# =============================================================================
# ⚠️  REQUIRED: Get your API key from Brevo Dashboard
# Visit: https://app.brevo.com/settings/api-keys
BREVO_API_KEY=your-actual-brevo-api-key-here

# ⚠️  REQUIRED: Email must be verified in Brevo Dashboard
# Visit: https://app.brovo.com/settings/sender-emails
BREVO_SENDER_EMAIL=noreply@garieva-prince.com  # Must be verified!
BREVO_SENDER_NAME=Garieva Prince

# =============================================================================
# CLOUDFLARE R2 MEDIA STORAGE (Optional for some platforms)
# Required only for Cloudflare Workers deployment
# =============================================================================
R2_ACCOUNT_ID=your-cloudflare-account-id  # Get from Cloudflare Dashboard → R2 → Overview
R2_ACCESS_KEY_ID=your-r2-access-key      # Generate in R2 Settings → API Keys
R2_SECRET_ACCESS_KEY=your-r2-secret-key   # Generated with access key
R2_PUBLIC_BUCKET_NAME=garieva-prince-media-public
R2_PRIVATE_BUCKET_NAME=garieva-prince-media-private
R2_PUBLIC_BASE_URL=https://garieva-prince-media-public.r2.cloudflarestorage.com

# =============================================================================
# ADMIN USER ID (For admin routes and D1 authorization)
# =============================================================================
# Set to user ID of your super_admin account in D1 database
# Leave empty for local development (auto-generated)
ADMIN_USER_ID=your-super-admin-user-id-from-d1  # Get from D1.users table

# =============================================================================
# NODE_ENV (Always set to production in production)
# =============================================================================
NODE_ENV=production

# =============================================================================
# DEPLOYMENT PLATFORM SPECIFIC SETTINGS
# =============================================================================

# For Cloudflare Workers:
# - Use wrangler secrets put to set sensitive values
# - Keep this file for documentation only

# For Vercel:
# - Add these to Vercel Dashboard → Settings → Environment Variables
# - Use platform secrets instead of committing here

# For Railway/Render:
# - Add these to platform settings → Environment Variables
# - Use platform secrets instead of committing here

# =============================================================================
# GENERATE SECURE PRODUCTION SECRETS
# =============================================================================
# Run this command once to generate random secrets:
# npm run generate-secrets
# 
# OR use openssl:
# AUTH_SESSION_SECRET=$(openssl rand -hex 32)
# AUTH_OTP_PEPPER=$(openssl rand -hex 16)
# =============================================================================

# =============================================================================
# ENVIRONMENT VARIABLES FOR PLATFORMS
# =============================================================================
# Add these to your deployment platform's environment variables:
# 
# Vercel: Settings → Environment Variables → Add each variable
# Railway: Settings → Environment → Add each variable  
# Render: Settings → Environment → Add each variable
# Cloudflare: wrangler secrets put --env production
# =============================================================================

# Example Vercel deployment command with env vars:
# vercel deploy --env \
#   --var DATABASE_URL="cloudflare:D1:your-db-id" \
#   --var AUTH_SESSION_SECRET="$(openssl rand -hex 32)" \
#   --var BREVO_API_KEY="your-brevo-key" \
#   ... etc

# =============================================================================
# DATABASE MIGRATION INSTRUCTIONS
# =============================================================================
# After deployment, apply migrations to your database:
# 
# Cloudflare D1:
#   Visit: https://dash.cloudflare.com/ → Workers & AI → D1 → SQL
#   Execute each migration file in order (0001.sql through 0006.sql)
# 
# PostgreSQL:
#   Run all migrations via SQL Runner or psql command
#   See cloudflare/migrations/apply-postgres.sql for combined script

# =============================================================================
# POST-DEPLOYMENT VERIFICATION
# =============================================================================
# After deployment, verify these endpoints work:
#   GET /api/health           → Should return {"status":"ok"}
#   GET /products              → Should show product catalog
#   GET /api/payments/approve → Admin endpoint (requires auth)

# Check logs for errors in platform dashboard
# Monitor Brevo email delivery (check Brevo Dashboard)

# =============================================================================
# ROLLBACK INSTRUCTIONS
# =============================================================================
# If deployment fails or issues occur:
# 
# Vercel: Deployments tab → Previous deployment → Promote to production
# Cloudflare: wrangler deploy --prev-branch=latest
# Railway/Render: Deployment history → Previous → Promote

# =============================================================================
# SECURITY CHECKLIST
# =============================================================================
# ✅ Never commit .env.production to Git (add to .gitignore)
# ✅ Use platform secrets instead of file-based secrets
# ✅ Generate strong random values for AUTH_SESSION_SECRET and AUTH_OTP_PEPPER
# ✅ Verify all environment variables are set correctly in platform dashboard
# ✅ Enable HTTPS on all routes (automatic on most platforms)
# ✅ Set up database backups
# ✅ Configure rate limiting in platform settings
# ✅ Add monitoring/alerting (Sentry, UptimeRobot, etc.)

# =============================================================================
# SUPPORT RESOURCES
# =============================================================================
# Brevo Docs: https://help.brevo.com/
# Cloudflare Workers Docs: https://developers.cloudflare.com/workers/
# Vercel Docs: https://vercel.com/docs
# Railway Docs: https://docs.railway.app/
# Render Docs: https://render.com/docs

# =============================================================================
# DEPLOYMENT COMMANDS
# =============================================================================
# Cloudflare Workers:
#   npx wrangler deploy garieva-prince --env production
# 
# Vercel:
#   vercel deploy --prod
# 
# Railway/Render:
#   Automatic on git push after environment variables are set

# =============================================================================
# END OF FILE - DO NOT EDIT VALUES WITHOUT KNOWING WHAT YOU'RE CHANGING
# =============================================================================