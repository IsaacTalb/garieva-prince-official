# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files - NEVER commit production secrets to Git!
.env.local
.env.production
.env.development
.env.test
!.env.example
!.env.local.example  # Example file that can be safely shared

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local package cache
/.npm-cache/
.npm/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# logs
*.log
logs/

# temporary files
.cache/
.temp/
tmp/

# database (SQLite file for local development)
*.db
*.sqlite
dev.db

# generated documentation that shouldn't be tracked
docs/*.md  # Unless explicitly committed

# Transitional integration folders - keep these ignored to prevent Vercel from auto-detecting them
.clerk/
.supabase/
.vercel/  # Vercel deployment metadata

# Cloudflare (optional, but good to exclude)
/cloudflare/

<EOF>