# Garieva Prince - local/server environment
APP_URL=http://localhost:3000

# Custom authentication
AUTH_SESSION_SECRET=replace_with_at_least_32_random_bytes
AUTH_OTP_PEPPER=replace_with_an_independent_random_secret
AUTH_OTP_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000

# Brevo transactional email
BREVO_API_KEY=xkeysib-replace_me
BREVO_SENDER_EMAIL=noreply@garievaprince.com
BREVO_SENDER_NAME=Garieva Prince

# Cloudflare resources are bound in Workers/Wrangler in production.
# These names are documentation/local-tooling hints, not browser secrets.
CLOUDFLARE_D1_DATABASE_NAME=garieva-prince
CLOUDFLARE_R2_BUCKET_NAME=garieva-prince-media
R2_PUBLIC_BASE_URL=https://assets.garievaprince.com
