# Public foundation can build without provider credentials.
# Never commit real secrets. Use local/Cloudflare environment settings.

APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# DATABASE SETUP
# For LOCAL DEVELOPMENT, use SQLite (no Cloudflare needed):
#   DATABASE_URL=sqlite:./dev.db
# OR leave unset to use default sqlite:./dev.db automatically
#
# For CLOUDFLARE PRODUCTION, after D1 database is created:
#   DATABASE_URL=cloudflare:D1:your-database-id
# ---------------------------------------------------------------------------

DATABASE_URL=  # Leave empty for local SQLite auto-config, or set Cloudflare binding for production

CLOUDFLARE_D1_DATABASE_NAME=garieva-prince  # Your D1 database name (will be used when deployed)

# ---------------------------------------------------------------------------
# CLOUDFLARE SESSION SECRETS (Required for authentication)
# Generate with: openssl rand -hex 32
# For local development, you can use a temporary secret, but it MUST be set!
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=your-super-secret-key-change-this-in-production-min-32-chars
AUTH_OTP_PEPPER=your-pepper-key-min-16-chars

# ---------------------------------------------------------------------------
# BREVO EMAIL SERVICE (Transactional OTP delivery)
# Sign up at https://brevo.com/ and get your API key
# For local development, you can use a test Brevo account:
#   - Create free account at brevo.com
#   - Go to Settings > API Keys > Generate API Key
#   - Use that key below
# ---------------------------------------------------------------------------
BREVO_API_KEY=  # Get from https://app.brevo.com/api/v1/brevo/sender-emails and Settings > API Keys
BREVO_SENDER_EMAIL=your-sender@example.com  # Email that will send OTP codes (must be verified in Brevo)
BREVO_SENDER_NAME=Garieva Prince

# ---------------------------------------------------------------------------
# CLOUDFLARE R2 MEDIA STORAGE (Optional for local dev)
# Final bindings will be configured in the Worker/Wrangler deployment phase.
# For local development, R2 is optional - the app will work without it initially.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=  # Cloudflare R2 account ID (get from Cloudflare Dashboard > R2 > Create bucket)
R2_ACCESS_KEY_ID=  # R2 access key for authenticated uploads
R2_SECRET_ACCESS_KEY=  # R2 secret access key
R2_PUBLIC_BUCKET_NAME=garieva-prince-media-public
R2_PRIVATE_BUCKET_NAME=garieva-prince-media-private
R2_PUBLIC_BASE_URL=  # CDN URL for public media (e.g., https://your-cdn.r2.cloudflarestorage.com)

# ---------------------------------------------------------------------------
# ADMIN USER ID (For admin routes and D1 authorization)
# This should be the user ID of your super_admin account in D1
# Generate a test admin user first, then use their ID here
# ---------------------------------------------------------------------------
ADMIN_USER_ID=  # Set to user ID of super_admin in D1 (will be auto-generated if not set for local dev)

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT QUICK START
# Copy this file to .env.local and edit:
#   1. Set AUTH_SESSION_SECRET to a random 32+ character string
#      Example: npm run generate-secrets (if you have the script)
#      Or manually: echo "AUTH_SESSION_SECRET=$(openssl rand -hex 32)" >> .env.local
#   2. Set BREVO_API_KEY from your Brevo account
#   3. Leave DATABASE_URL empty for SQLite local dev
#
# Then run: npm run dev
# ---------------------------------------------------------------------------