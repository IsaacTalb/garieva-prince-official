# Integrations are optional for building and viewing the public foundation.
# Configure real values securely in .env.local / Vercel settings; never commit them.
# Auth0: Regular Web Application. Domain only, no scheme.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Generate locally: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Supabase PostgreSQL ONLY. Use a transaction pooler URL and verified TLS.
# This must be a raw server-side connection credential, not a proxy placeholder.
DATABASE_URL=

# R2 signing requires raw server-side credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Separate buckets required. Only product media is public by default.
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# No email, payment provider, or NFC signing credential is required in this phase.
