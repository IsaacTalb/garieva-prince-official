R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# TARGET GP AUTH + EMAIL
# Custom passwordless email verification + opaque sessions.
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=
AUTH_OTP_PEPPER=
AUTH_OTP_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
