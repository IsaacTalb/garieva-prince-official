# Public foundation can build without provider credentials.
# Never commit real secrets. Use local/Cloudflare environment settings.

APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CLOUDFLARE D1 DATABASE (Primary Runtime)
# See docs/CLOUDFLARE.md for setup instructions
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./dev.db  # Local development: SQLite file
# DATABASE_URL=cloudflare:D1:your-database-id  # Production: Cloudflare binding

CLOUDFLARE_D1_DATABASE_NAME=garieva-prince

# ---------------------------------------------------------------------------
# CLOUDFLARE R2 MEDIA STORAGE (Optional for local dev)
# Final bindings will be configured in the Worker/Wrangler deployment phase.
# See docs/CLOUDFLARE.md for setup instructions
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_PUBLIC_BUCKET_NAME=garieva-prince-media-public
R2_PRIVATE_BUCKET_NAME=garieva-prince-media-private
R2_PUBLIC_BASE_URL=https://your-cdn.r2.cloudflarestorage.com

# ---------------------------------------------------------------------------
# CLOUDFLARE SESSION SECRETS (Required for authentication)
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
AUTH_SESSION_SECRET=
AUTH_OTP_PEPPER=

# ---------------------------------------------------------------------------
# BREVO EMAIL SERVICE (Transactional OTP delivery)
# See docs/PHASE_3_COMPLETION.md for setup instructions
# ---------------------------------------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Garieva Prince